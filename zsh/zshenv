# zsh loads this file for every shell: login, non-login, interactive, and
# non-interactive. Keep it small and fast; scripts and agent tool commands read
# it too.
#
# pnpm must be available here, not only in .zprofile or .zshrc, because commands
# like `zsh -c "vercel --version"` do not load login or interactive startup
# files. PNPM_HOME is pnpm's configured global bin directory, and
# PNPM_HOME/bin contains executables installed with `pnpm add -g`.
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac

# Vite+ bin (https://viteplus.dev)
if [[ -r "$HOME/.config/vite-plus/env" ]]; then
  . "$HOME/.config/vite-plus/env"
fi
