# zsh loads this file for interactive shells only. It is the right place for
# prompts, aliases, completions, and Oh My Zsh. Plain `zsh -c "command"` does
# not read this file.
#
# pnpm is configured in .zshenv so non-interactive scripts and agent tool shells
# can also find node, pnpm, and globally installed commands.

# OhMyZsh
## Path to installation
export ZSH="$HOME/.oh-my-zsh"
## Theme
ZSH_THEME="af-magic"
### Theme config
DEFAULT_USER="$USER"
## Plugins
plugins=(git)
## Updates
# zsh/oh-my-zsh-commit in the dotfiles repo pins the version. Update on purpose
# with `omz update`, then record the new commit there.
zstyle ':omz:update' mode disabled
## Load
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

# Composio CLI
export COMPOSIO_INSTALL_DIR="$HOME/.composio"
export PATH="$COMPOSIO_INSTALL_DIR:$PATH"

# Aliases

## General
alias lah="ls -lah"

# Vite+ bin (https://viteplus.dev)
# .zshenv sources this too. Sourcing it again here moves the Vite+ bin back in
# front of Homebrew, which .zprofile prepends, and adds `vp` completions now
# that Oh My Zsh has defined compdef.
if [[ -r "$HOME/.config/vite-plus/env" ]]; then
  . "$HOME/.config/vite-plus/env"
fi

# Rust (Homebrew rustup is keg-only)
export PATH="/opt/homebrew/opt/rustup/bin:$PATH"

# Distrusted CA roots (ca/README.md)
# macOS updates can put a distrusted root back into /etc/ssl/cert.pem. When the
# file's inode, mtime, or size differs from the last check, ask the ca script.
# Otherwise this costs one zstat. scripts/ca.ts writes the stamp's first line.
() {
  local cert=/etc/ssl/cert.pem stamp="$HOME/.local/state/dotfiles/ca/last-check"
  [[ -r $cert ]] && zmodload -F zsh/stat b:zstat 2>/dev/null || return 0
  local -A st
  local -a seen
  zstat -H st -- $cert 2>/dev/null || return 0
  [[ -r $stamp ]] && seen=("${(@f)$(<$stamp)}")
  [[ ${seen[1]-} == "$st[inode] $st[mtime] $st[size]" ]] && return 0
  local repo=${${(%):-%x}:A:h:h}
  if [[ -x $repo/node_modules/.bin/tsx ]]; then
    $repo/node_modules/.bin/tsx $repo/scripts/ca.ts status
  else
    print -r -- "dotfiles: $cert changed. Run \`pnpm install\`, then \`pnpm run ca install\` in $repo."
  fi
}
