{
  "name": "@bjardon/dotfiles",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && tsx scripts/skills.ts check && tsx scripts/agents.ts check",
    "skills": "tsx scripts/skills.ts",
    "test": "pnpm run typecheck && tsx --test tests/*.test.ts",
    "agents": "tsx scripts/agents.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
